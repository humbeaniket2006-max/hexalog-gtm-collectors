# Create a read-only Reddit script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hexalog-gtm-collectors/0.1 by YOUR_REDDIT_USERNAME
# Create an API key in Google Cloud Console (YouTube Data API v3).
YOUTUBE_API_KEY=
# Create a Notion integration at https://www.notion.so/my-integrations. Share all four databases with it.
NOTION_API_KEY=
# Optional overrides. REDDIT_SUBREDDITS/REDDIT_PAIN_POINT_KEYWORDS/REDDIT_COMPETITOR_KEYWORDS
# are comma-separated lists; YOUTUBE_CHANNELS stays JSON.
# REDDIT_SUBREDDITS=freightforwarding,IndiaBusiness,smallbusinessindia
# REDDIT_PAIN_POINT_KEYWORDS=customs,landed cost,freight forwarder,export,import,cross border,MSME
# REDDIT_COMPETITOR_KEYWORDS=Cogoport,ClickPost,Shiprocket,WareIQ,ShipGlobal,Easyship,Shipsy,Fastrr
# YOUTUBE_CHANNELS={"cogoport":"CHANNEL_ID"}
